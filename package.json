{
  "name": "phu-quoc-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static Leaflet map of Phú Quốc spots + travel tips. No build step.",
  "scripts": {
    "them-anh": "node tools/them-anh.mjs",
    "them-anh:publish": "node tools/them-anh.mjs --publish",
    "test-image": "node tools/make-test-image.mjs anh-moi/test-gps.jpg",
    "serve": "python -m http.server 8080"
  },
  "devDependencies": {
    "exifr": "^7.1.3",
